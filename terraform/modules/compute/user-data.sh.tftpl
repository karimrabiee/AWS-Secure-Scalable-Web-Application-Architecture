#!/bin/bash
# Bootstrap for the Nimbus Store application tier (Amazon Linux 2023).
# Rendered by Terraform templatefile(). Placeholders are substituted before the instance
# boots; any literal bash parameter expansion with braces would need a doubled dollar sign.
# Stack: Nginx -> Gunicorn -> Flask -> Amazon RDS (credentials from Secrets Manager).
# The application code is pulled from a private S3 release bucket and verified by SHA-256.
set -Eeuo pipefail

LOG=/var/log/ecomm-bootstrap.log
exec > >(tee -a "$LOG") 2>&1

log() { printf '[ecomm-bootstrap] %s\n' "$*" >&2; }
trap 'log "FAILED at line $LINENO - see $LOG and /var/log/cloud-init-output.log"' ERR

retry() {
  local attempts=$1 delay=$2 n=1
  shift 2
  until "$@"; do
    if (( n >= attempts )); then
      return 1
    fi
    log "retry $n/$attempts: $*"
    sleep "$delay"
    n=$((n + 1))
  done
}

APP_DIR=/opt/ecomm-app
CONF_DIR=/etc/ecomm-app
PYTHON=/usr/bin/python3

log "Installing OS packages"
retry 5 10 dnf install -y nginx python3 python3-pip
"$PYTHON" -c 'import sys; assert sys.version_info >= (3, 9), sys.version'
mkdir -p "$APP_DIR" "$CONF_DIR" /var/lib/app

# Instance metadata is presentation data only: never let it block startup (IMDSv2 only).
imds() {
  local token
  token=$(curl -sf --max-time 5 -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 60" \
    http://169.254.169.254/latest/api/token) || return 1
  curl -sf --max-time 5 -H "X-aws-ec2-metadata-token: $token" \
    "http://169.254.169.254/latest/meta-data/$1"
}
AZ=$(retry 3 2 imds placement/availability-zone) || AZ=unknown
INSTANCE_ID=$(retry 3 2 imds instance-id) || INSTANCE_ID=unknown
printf '%s' "$AZ" > /var/lib/app/az.txt
printf '%s' "$INSTANCE_ID" > /var/lib/app/instance-id.txt

log "Downloading application release ${app_release}"
retry 6 10 aws s3 sync "s3://${app_bucket}/releases/${app_release}/" "$APP_DIR/" \
  --region "${aws_region}" --only-show-errors
cat > "$CONF_DIR/release.sha256" <<'MANIFEST'
${app_manifest}
MANIFEST
# Refuse to run anything that differs from what Terraform published.
(cd "$APP_DIR" && sha256sum --check --quiet "$CONF_DIR/release.sha256")

log "Creating virtualenv and installing pinned dependencies"
retry 3 10 "$PYTHON" -m venv "$APP_DIR/venv"
retry 5 10 "$APP_DIR/venv/bin/pip" install --no-cache-dir --disable-pip-version-check \
  -r "$APP_DIR/requirements.txt"
"$APP_DIR/venv/bin/python" -m py_compile "$APP_DIR/app.py" "$APP_DIR/db.py"

log "Fetching the Amazon RDS CA bundle for verified TLS"
retry 5 10 curl -sf --max-time 30 -o "$CONF_DIR/rds-global-bundle.pem" \
  https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
grep -q 'BEGIN CERTIFICATE' "$CONF_DIR/rds-global-bundle.pem"

# Connection settings only. The database password is never written to disk: the app
# reads it from Secrets Manager at runtime using the instance role.
cat > "$CONF_DIR/app.env" <<'ENVFILE'
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_SECRET_ARN=${db_secret_arn}
DB_SSL_CA=/etc/ecomm-app/rds-global-bundle.pem
AWS_REGION=${aws_region}
AWS_DEFAULT_REGION=${aws_region}
ENVFILE

# Dedicated non-login account. Code and virtualenv stay root-owned (read-only to the service).
id ecomm-app >/dev/null 2>&1 || useradd --system --home-dir "$APP_DIR" --shell /sbin/nologin ecomm-app
chown -R root:root "$APP_DIR"
chmod -R go-w "$APP_DIR"
chmod -R a+rX "$APP_DIR"
chown -R ecomm-app:ecomm-app /var/lib/app
chown root:ecomm-app "$CONF_DIR" "$CONF_DIR/app.env" "$CONF_DIR/rds-global-bundle.pem"
chmod 750 "$CONF_DIR"
chmod 640 "$CONF_DIR/app.env" "$CONF_DIR/rds-global-bundle.pem"

log "Initialising the database schema (idempotent)"
if retry 10 15 runuser -u ecomm-app -- bash -c \
  "set -a; . $CONF_DIR/app.env; set +a; cd $APP_DIR && ./venv/bin/python db.py init"; then
  log "Database schema is ready"
else
  log "WARNING: schema initialisation failed; catalog pages return 503 until the database is reachable"
fi

cat > /etc/systemd/system/ecomm-app.service <<'SERVICE'
[Unit]
Description=Nimbus Store (Gunicorn + Flask)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ecomm-app
Group=ecomm-app
WorkingDirectory=/opt/ecomm-app
EnvironmentFile=/etc/ecomm-app/app.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ecomm-app/venv/bin/gunicorn --workers 2 --threads 4 --worker-class gthread --bind 127.0.0.1:8000 --timeout 30 --access-logfile - --error-logfile - app:app
ExecStartPost=/bin/bash -c 'for i in $(seq 1 20); do /usr/bin/curl -sf http://127.0.0.1:8000/health >/dev/null && exit 0; sleep 1; done; echo "Application health check timed out" >&2; exit 1'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
SERVICE

# A complete nginx.conf replaces the packaged one: Amazon Linux ships a default server
# block inside nginx.conf, and a second default_server on port 80 would conflict with ours.
cat > /etc/nginx/nginx.conf <<'NGINX'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 1m;
    access_log /var/log/nginx/access.log;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    server {
        listen 80 default_server;
        server_name _;

        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_connect_timeout 3s;
            proxy_read_timeout 30s;
        }
    }
}
NGINX
rm -f /etc/nginx/conf.d/default.conf
nginx -t

systemctl daemon-reload
systemctl enable ecomm-app nginx
systemctl restart ecomm-app
systemctl restart nginx

log "Waiting for the local health endpoint"
retry 12 5 curl -sf --max-time 5 http://127.0.0.1/health >/dev/null
retry 6 5 curl -sf --max-time 5 http://127.0.0.1/ready >/dev/null \
  || log "WARNING: /ready is not OK yet; check database connectivity (see docs/TROUBLESHOOTING.md)"
log "Bootstrap complete"

#!/bin/bash
set -Eeuo pipefail

# Keep cloud-init diagnostics available without enabling shell tracing (which
# could expose future sensitive values in command arguments).
exec > >(tee -a /var/log/ecomm-app-bootstrap.log | logger -t ecomm-app-bootstrap -s 2>/dev/console) 2>&1

APP_DIR=/opt/ecomm-app
mkdir -p "$APP_DIR" /var/lib/app

# Amazon Linux 2023 supplies Python 3.9 by default in the currently deployed
# environment. The application is intentionally compatible with Python 3.9.
dnf install -y nginx python3 python3-pip curl

# IMDSv2 only; no instance metadata values are secrets.
TOKEN=$(curl --silent --show-error --fail --max-time 5 -X PUT \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 60" \
  http://169.254.169.254/latest/api/token)
AZ=$(curl --silent --show-error --fail --max-time 5 \
  -H "X-aws-ec2-metadata-token: $${TOKEN}" \
  http://169.254.169.254/latest/meta-data/placement/availability-zone)
INSTANCE_ID=$(curl --silent --show-error --fail --max-time 5 \
  -H "X-aws-ec2-metadata-token: $${TOKEN}" \
  http://169.254.169.254/latest/meta-data/instance-id)
printf '%s' "$${AZ}" > /var/lib/app/az.txt
printf '%s' "$${INSTANCE_ID}" > /var/lib/app/instance-id.txt

# Terraform embeds only the application source and pinned dependency list.
printf '%s' '${app_py_b64}' | base64 --decode > "$APP_DIR/app.py"
printf '%s' '${requirements_b64}' | base64 --decode > "$APP_DIR/requirements.txt"
python3 -m venv "$APP_DIR/venv"
"$APP_DIR/venv/bin/python" -m pip install --no-cache-dir --requirement "$APP_DIR/requirements.txt"

# Fail bootstrap before the instance can be considered ready if Python syntax,
# Flask import, or the health endpoint is broken.
"$APP_DIR/venv/bin/python" -m py_compile "$APP_DIR/app.py"
PYTHONPATH="$APP_DIR" "$APP_DIR/venv/bin/python" - <<'PYAPP'
from app import app
client = app.test_client()
health = client.get("/health")
assert health.status_code == 200, f"/health returned {health.status_code}"
assert health.get_data(as_text=True) == "OK", "Unexpected /health response body"
home = client.get("/")
assert home.status_code == 200, f"/ returned {home.status_code}"
PYAPP

# Use a dedicated non-login account. Application code and its virtualenv stay
# root-owned/read-only to the service user; only metadata is owned by the app.
id ecomm-app >/dev/null 2>&1 || useradd --system --home-dir "$APP_DIR" --shell /sbin/nologin ecomm-app
chown -R root:root "$APP_DIR"
chmod -R go-w "$APP_DIR"
chown -R ecomm-app:ecomm-app /var/lib/app
chmod 755 "$APP_DIR"

cat > /etc/systemd/system/ecomm-app.service <<'SERVICE'
[Unit]
Description=E-commerce Flask application
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ecomm-app
Group=ecomm-app
WorkingDirectory=/opt/ecomm-app
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ecomm-app/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - app:app
ExecStartPost=/bin/bash -c 'for i in {1..20}; do /usr/bin/curl --fail --silent http://127.0.0.1:8000/health >/dev/null && exit 0; sleep 1; done; echo "Application health check timed out" >&2; exit 1'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
SERVICE

cat > /etc/nginx/conf.d/ecomm-app.conf <<'NGINX'
server {
    listen 80 default_server;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
}
NGINX

# Amazon Linux's package may provide a competing default virtual host.
rm -f /etc/nginx/conf.d/default.conf
NGINX_TEST_OUTPUT=$(nginx -t 2>&1) || {
  printf '%s\n' "$${NGINX_TEST_OUTPUT}" >&2
  exit 1
}
printf '%s\n' "$${NGINX_TEST_OUTPUT}"
if printf '%s\n' "$${NGINX_TEST_OUTPUT}" | grep -qi 'conflicting server name'; then
  echo "Nginx has conflicting server_name declarations; refusing to start." >&2
  exit 1
fi
systemctl daemon-reload
systemctl enable ecomm-app nginx
systemctl restart ecomm-app
systemctl restart nginx

# Final end-to-end local checks before cloud-init completes.
for attempt in {1..20}; do
  if curl --fail --silent --show-error http://127.0.0.1:8000/health >/dev/null \
    && curl --fail --silent --show-error http://127.0.0.1/health >/dev/null; then
    echo "Application and Nginx health checks passed."
    exit 0
  fi
  sleep 2
done

echo "Application failed post-start health checks; inspect systemd and bootstrap logs." >&2
systemctl --no-pager --full status ecomm-app nginx || true
journalctl -u ecomm-app -n 100 --no-pager || true
exit 1

#!/bin/bash
# Application-tier bootstrap: Nginx -> Gunicorn -> Flask -> RDS (Terraform templatefile; $${VAR} = shell).
set -Eeuo pipefail

LOG_FILE=/var/log/ecomm-bootstrap.log
APP_DIR=/opt/ecomm-app
APP_USER=ecomm-app

# Logged to a file and the journal (journalctl -t ecomm-bootstrap). Shell tracing stays off: it could leak values.
exec > >(tee -a "$LOG_FILE" | logger -t ecomm-bootstrap) 2>&1

# stderr, so it never pollutes values captured with $(...)
log() { printf '[ecomm-bootstrap] %s\n' "$*" >&2; }

on_error() {
  local line=$1
  log "ERROR: bootstrap failed at line $${line}; see $LOG_FILE, cloud-init-output.log, journalctl -u ecomm-app"
  journalctl -u ecomm-app -n 40 --no-pager 2>&1 || true
}
trap 'on_error $LINENO' ERR

# retry <attempts> <delay-seconds> <command...>  - bounded, never loops forever.
retry() {
  local attempts=$1 delay=$2 attempt=1
  shift 2
  until "$@"; do
    if (( attempt >= attempts )); then
      log "ERROR: '$*' failed after $${attempts} attempts"
      return 1
    fi
    log "Command failed; retry $${attempt}/$${attempts} in $${delay}s: $1"
    sleep "$delay"
    attempt=$((attempt + 1))
  done
}

log "Bootstrap started"

# ---------------------------------------------------------------- packages --
retry 5 10 dnf install -y nginx python3.11 python3.11-pip curl
python3.11 -c 'import sys; assert sys.version_info >= (3, 11), sys.version'
log "Python runtime: $(python3.11 --version)"

# --------------------------------------------------- service account & dirs --
id "$APP_USER" >/dev/null 2>&1 || useradd --system --home-dir "$APP_DIR" --shell /sbin/nologin "$APP_USER"
mkdir -p "$APP_DIR" /var/lib/app
install -d -m 0750 -o root -g "$APP_USER" /etc/ecomm-app

# ----------------------------------------------- instance metadata (IMDSv2) --
# Presentation only: never fatal.
TOKEN=$(curl -s -m 5 -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 60" http://169.254.169.254/latest/api/token || true)
meta() { curl -sf -m 5 -H "X-aws-ec2-metadata-token: $${TOKEN}" "http://169.254.169.254/latest/meta-data/$1" || printf unknown; }
AZ=$(meta placement/availability-zone)
INSTANCE_ID=$(meta instance-id)
printf '%s' "$${AZ}" > /var/lib/app/az.txt
printf '%s' "$${INSTANCE_ID}" > /var/lib/app/instance-id.txt
log "Instance $${INSTANCE_ID} in $${AZ}"

# --------------------------------------------------------- application code --
# Source embedded by Terraform (no secrets): no repository or artifact bucket needed.
%{ for name, content in app_files ~}
mkdir -p "$APP_DIR/$(dirname '${name}')"
cat > "$APP_DIR/${name}" <<'__ECOMM_APP_FILE__'
${content}
__ECOMM_APP_FILE__
%{ endfor ~}

retry 3 10 python3.11 -m venv "$APP_DIR/venv"
retry 5 10 "$APP_DIR/venv/bin/pip" install --no-cache-dir --disable-pip-version-check -r "$APP_DIR/requirements.txt"

# Public RDS CA bundle (certificate + host-name verification). Failure keeps /health green but /ready red.
mkdir -p "$APP_DIR/certs"
if retry 5 5 curl --silent --show-error --fail --max-time 30 \
     -o "$APP_DIR/certs/rds-global-bundle.pem" \
     https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
   && grep -q 'BEGIN CERTIFICATE' "$APP_DIR/certs/rds-global-bundle.pem"; then
  log "RDS CA bundle installed"
else
  log "ERROR: RDS CA bundle download failed; database connections will be refused until fixed"
fi

# Non-secret config only: the password is read from Secrets Manager at runtime.
cat > /etc/ecomm-app/app.env <<'APPENV'
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_SECRET_ARN=${db_secret_arn}
AWS_REGION=${aws_region}
AWS_DEFAULT_REGION=${aws_region}
DB_SSL_CA=/opt/ecomm-app/certs/rds-global-bundle.pem
LOG_LEVEL=INFO
APPENV
chown root:"$APP_USER" /etc/ecomm-app/app.env
chmod 0640 /etc/ecomm-app/app.env

# Code stays root-owned; the service account can read but not modify it.
chown -R root:root "$APP_DIR"
chmod -R go-w "$APP_DIR"
chmod 755 "$APP_DIR"
chown -R "$APP_USER":"$APP_USER" /var/lib/app

# Self-test before starting (would have caught the Python 3.9 `str | Path` incident); no database needed.
(cd "$APP_DIR" && env -u DB_HOST "$APP_DIR/venv/bin/python" - <<'SELFTEST'
from app import app
client = app.test_client()
health = client.get("/health")
assert health.status_code == 200 and health.get_data(as_text=True) == "OK", health.status_code
assert client.get("/").status_code == 200, "home page failed to render"
print("application self-test passed")
SELFTEST
)

# ------------------------------------------------------------ systemd service --
cat > /etc/systemd/system/ecomm-app.service <<'SERVICE'
[Unit]
Description=Nimbus Store Flask application (Gunicorn)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ecomm-app
Group=ecomm-app
WorkingDirectory=/opt/ecomm-app
EnvironmentFile=/etc/ecomm-app/app.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ecomm-app/venv/bin/gunicorn --workers 2 --threads 4 --timeout 30 --graceful-timeout 20 --max-requests 1000 --max-requests-jitter 100 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - app:app
ExecStartPost=/bin/bash -c 'for i in {1..20}; do /usr/bin/curl --fail --silent http://127.0.0.1:8000/health >/dev/null && exit 0; sleep 1; done; echo "Application health check timed out" >&2; exit 1'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
SERVICE

# --------------------------------------------------------------------- nginx --
# Complete nginx.conf: exactly one server block (no default-vhost conflict).
cat > /etc/nginx/nginx.conf <<'NGINX'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 64k;

    access_log /var/log/nginx/access.log;

    gzip on;

    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    server {
        listen 80 default_server;
        server_name _;

        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 3s;
            proxy_read_timeout 30s;
        }
    }
}
NGINX

nginx -t

systemctl daemon-reload
systemctl enable ecomm-app nginx
systemctl restart ecomm-app
systemctl restart nginx

# ------------------------------------------------------------ final checks --
# Done only when the ALB health path works end to end (bounded: 12 x 5 s).
retry 12 5 curl --silent --fail --max-time 5 http://127.0.0.1/health >/dev/null
log "Local /health returned HTTP 200 through Nginx"

# Database readiness is reported, never fatal (the ALB check is independent of RDS).
if curl --silent --fail --max-time 10 http://127.0.0.1/ready >/dev/null; then
  log "Database readiness check passed"
else
  log "WARNING: database not ready yet (IAM, secret, security group or TLS bundle?). Run: curl -s http://127.0.0.1/ready ; journalctl -u ecomm-app -n 50"
fi
log "Bootstrap completed"

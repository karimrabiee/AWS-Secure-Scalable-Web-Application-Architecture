# The application supports the Amazon Linux 2023 Python 3.9 runtime.
PYTHON_BIN=/usr/bin/python3
"$PYTHON_BIN" --version | tee -a /var/log/ecomm-bootstrap.log
"$PYTHON_BIN" -c 'import sys; assert sys.version_info >= (3, 9), sys.version'

# IMDSv2 metadata is optional presentation data; failure must not prevent the
# application from starting or make the ALB report a false outage.
read_metadata() {
  local token value
  token=$(curl --silent --fail --max-time 5 -X PUT \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" \
    http://169.254.169.254/latest/api/token) || return 1
  value=$(curl --silent --fail --max-time 5 \
    -H "X-aws-ec2-metadata-token: $${token}" "$1") || return 1
  printf '%s' "$${value}"
}

AZ=unknown
INSTANCE_ID=unknown
if AZ=$(retry 3 2 read_metadata http://169.254.169.254/latest/meta-data/placement/availability-zone); then
  :
else
  log "Availability-zone metadata unavailable; using fallback"
  AZ=unknown
fi
if INSTANCE_ID=$(retry 3 2 read_metadata http://169.254.169.254/latest/meta-data/instance-id); then
  :
else
  log "Instance-id metadata unavailable; using fallback"
  INSTANCE_ID=unknown
fi
echo -n "$${AZ}" > /var/lib/app/az.txt
echo -n "$${INSTANCE_ID}" > /var/lib/app/instance-id.txt

# Terraform embeds application source and public dependency pins, not secrets.
echo '${app_py_b64}' | base64 -d > "$APP_DIR/app.py"
echo '${requirements_b64}' | base64 -d > "$APP_DIR/requirements.txt"
retry 3 10 "$PYTHON_BIN" -m venv "$APP_DIR/venv"
retry 5 10 "$APP_DIR/venv/bin/pip" install --no-cache-dir -r "$APP_DIR/requirements.txt"

id ecomm-app &>/dev/null || useradd --system --home-dir "$APP_DIR" --shell /sbin/nologin ecomm-app
chown -R ecomm-app:ecomm-app "$APP_DIR" /var/lib/app
